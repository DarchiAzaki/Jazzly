# 1. Discord Application Credentials (Required)
# Retrieve from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_client_id_here

# 2. Database Connection (Optional)
# Leave blank to use local memory cache with file persistence
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/jazzly?retryWrites=true&w=majority

# 3. Spotify API Credentials (Optional)
# Required for Spotify track and playlist metadata resolution
# Retrieve from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# 4. Default Playback & Behavior Settings
DEFAULT_PREFIX=!
DEFAULT_VOLUME=80
VOTE_SKIP_PERCENT=50
STAY_IN_VC_24_7=false
LEAVE_ON_EMPTY_TIMEOUT_SECONDS=60
ANNOUNCE_NOW_PLAYING=true

# 5. YouTube Cookie (Optional)
# Raw cookie string from browser session to bypass age restrictions
YOUTUBE_COOKIE=
